# Application key: api.agents.read, api.agents.write, api.responses.write.
OPENAI_API_KEY=
# Environment key from Agents > Environments > Keys; all other permissions None.
# Must share the application key's org/project/principal.
OPENAI_EXECUTOR_API_KEY=
# pnpm agent:create fills this in after the application key is configured.
OPENAI_AGENT_ID=
# Register /api/webhook for agent.session.action_required and agent.session.failed.
OPENAI_WEBHOOK_SECRET=
# Neon pooled Postgres URL, injected by Vercel integration.
# Prefer sslmode=verify-full. App and migrations normalize legacy SSL aliases
# to verify-full unless the URL explicitly sets uselibpqcompat=true.
DATABASE_URL=
APP_PASSWORD=
AUTH_SECRET=
CRON_SECRET=
# Local Sandbox/Queue auth: vercel env pull (automatically supplied on Vercel).
VERCEL_OIDC_TOKEN=
# Optional canonical origin. Leave unset locally.
APP_URL=
